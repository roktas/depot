#!/usr/bin/env bash

set -Eeuo pipefail; shopt -s nullglob; [[ -z ${TRACE:-} ]] || set -x; unset CDPATH; IFS=$' \n'

bye() {
	cry "$@"
	exit 0
}

cry() {
	echo -e >&2 "\033[1;36m$*\033[0m"
}

die() {
	echo -e >&2 "\033[1;31m$*\033[0m"
	exit 1
}

# ------------------------------------------------------------------------------------------------------------------------
# Helpers
# ------------------------------------------------------------------------------------------------------------------------

ask() {
	local answer

	echo -e -n >&2 "\033[1;33m$*\033[0m [y/n] "
	read -r answer

	[[ ${answer:-} == y ]]
}

askn() {
	local answer

	echo -e -n >&2 "\033[1;33m$*\033[0m [y/N] "
	read -r answer

	[[ ${answer:-} == y ]]
}

asky() {
	local answer

	echo -e -n >&2 "\033[1;33m$*\033[0m [Y/n] "
	read -r answer

	[[ ${answer:-} == y ]] || [[ -z ${answer:-} ]]
}

# ------------------------------------------------------------------------------------------------------------------------
# Main
# ------------------------------------------------------------------------------------------------------------------------

main() {
	cd "$(git rev-parse --show-toplevel 2>/dev/null)" || die "Not a Git repository"

	local message=${1:-}

	local branch
	local default
	local filelist
	local gitinfo
	local path
	local purge=
	local remote
	local tmpdir

	remote=$(git config remote.origin.url || true)
	[[ -n ${remote:-} ]] || die "No remote found"

	default=$(git remote show origin | awk '/HEAD branch/ {print $NF}')

	ask "This will reset '$default' branch on '$remote'" || bye "Bye"

	tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/git-renew.XXXXXXXX") || exit
	# shellcheck disable=2154
	trap 'err=$? && rm -rf "'"$tmpdir"'" || exit $err' EXIT HUP INT QUIT TERM

	filelist=$tmpdir/filelist
	gitinfo=$tmpdir/info

	while IFS= read -r -d $'\0' path; do
		[[ -e $path ]] || continue
		echo "$path"
	done < <(
		git ls-tree --full-tree -r -z --name-only HEAD
		git diff -z --name-only --cached --diff-filter=A
	) >"$filelist"

	cp -a .git/info "$gitinfo"

	if [[ -z $message ]]; then
		message=$(git rev-list --max-parents=0 --format='%s' --no-commit-header HEAD || true)
		[[ -n ${message:-} ]] || message="Initial commit"
	fi

	rm -rf .git

	git init --initial-branch="$default"
	rm -rf .git/info
	cp -a "$gitinfo" .git/info
	git add --force --pathspec-from-file="$filelist"
	git commit --no-verify -a -m "$message"
	git remote add origin "$remote"
	git push --force --set-upstream origin "$default"

	if askn "Delete all remote branches except '$default'"; then
		purge=true
	fi

	if [[ -n ${purge:-} ]]; then
		git fetch --all

		while read -r branch; do
			cry "✗    $branch"
			git push origin -d "$branch"
		done < <(
			git for-each-ref --format='%(refname:strip=3)' refs/remotes/origin |
				grep -vxF HEAD |
				grep -vxF "$default"
		)
	fi
}

main "$@"

#!/usr/bin/env bash
# Format changed Ruby files before control returns to the caller.

set -Eeuo pipefail
[[ -z ${TRACE:-} ]] || set -x
unset CDPATH

is_ruby_file() {
	local path=$1

	[[ -f $path ]] || return 1

	case ${path##*/} in
	Capfile | Gemfile | Guardfile | Rakefile | config.ru)
		return 0
		;;
	esac

	case $path in
	*.gemspec | *.rake | *.rb)
		return 0
		;;
	esac

	local first_line
	IFS= read -r first_line <"$path" || return 1

	[[ $first_line =~ ^#!.*ruby([[:space:]]|$) ]]
}

main() {
	command -v rubyfmt >/dev/null || exit 0
	git rev-parse --is-inside-work-tree >/dev/null 2>&1 || exit 0

	local root
	root=$(git rev-parse --show-toplevel)
	cd "$root"

	local path
	local -A seen=()
	local -a paths=()

	while IFS= read -r -d "" path; do
		[[ -n ${seen[$path]:-} ]] && continue
		seen[$path]=1
		paths+=("$path")
	done < <(
		git diff --name-only -z --diff-filter=ACMRTUXB
		git ls-files --others --exclude-standard -z
	)

	for path in "${paths[@]}"; do
		is_ruby_file "$path" || continue
		rubyfmt --in-place -- "$path"
	done
}

main "$@"

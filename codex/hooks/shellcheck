#!/usr/bin/env python3
"""Block completion when changed Bash scripts fail static analysis."""

import json
import os
import shutil
import subprocess
import sys
from pathlib import Path


def run(cmd, cwd=None):
    return subprocess.run(cmd, cwd=cwd, text=True, capture_output=True)


def git_root(cwd):
    result = run(["git", "rev-parse", "--show-toplevel"], cwd=cwd)
    if result.returncode != 0:
        return None
    return Path(result.stdout.strip())


def changed_paths(root):
    result = run(["git", "status", "--porcelain=v1", "--untracked-files=all"], cwd=root)
    if result.returncode != 0:
        return []

    paths = []
    for line in result.stdout.splitlines():
        if len(line) < 4:
            continue
        path = line[3:]
        if " -> " in path:
            path = path.split(" -> ", 1)[1]
        candidate = (root / path).resolve()
        if candidate.exists() and candidate.is_file():
            paths.append(candidate)
    return sorted(set(paths))


def is_bash_file(path):
    if path.suffix == ".sh":
        return True

    try:
        with path.open("rb") as handle:
            first_line = handle.readline(256)
    except OSError:
        return False

    return first_line.startswith(b"#!/") and b"bash" in first_line


def shellcheck_files(paths, cwd):
    command = ["shellcheck", "-f", "gcc", *[str(path) for path in paths]]
    return run(command, cwd=cwd)


def emit_block(reason):
    json.dump({"decision": "block", "reason": reason}, sys.stdout)
    sys.stdout.write("\n")


def main():
    try:
        payload = json.load(sys.stdin)
    except json.JSONDecodeError:
        return 0

    if shutil.which("shellcheck") is None:
        return 0

    cwd = payload.get("cwd") or os.getcwd()
    root = git_root(cwd)
    if root is None:
        return 0

    bash_files = [path for path in changed_paths(root) if is_bash_file(path)]
    if not bash_files:
        return 0

    result = shellcheck_files(bash_files, root)
    if result.returncode == 0:
        return 0

    if result.returncode not in (1, 2):
        return 0

    lines = [line for line in result.stdout.splitlines() if line.strip()]
    excerpt = "\n".join(lines[:40])
    if len(lines) > 40:
        excerpt += "\n..."

    reason = (
        "Run shellcheck on modified Bash files, fix all findings, rerun shellcheck, then respond."
        f"\n\nFiles:\n" + "\n".join(str(path.relative_to(root)) for path in bash_files)
    )
    if excerpt:
        reason += f"\n\nShellcheck output:\n{excerpt}"

    emit_block(reason)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

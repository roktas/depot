font-family = Ioskeley Mono
font-size = 18
font-synthetic-style = bold,italic,bold-italic
macos-option-as-alt = true

background = #2e3440
foreground = #d8dee9
selection-background = #4c566a
selection-foreground = #d8dee9
cursor-color = #d8dee9
cursor-text = #2e3440
bold-is-bright = true

palette = 0=#3b4252
palette = 1=#bf616a
palette = 2=#a3be8c
palette = 3=#ebcb8b
palette = 4=#81a1c1
palette = 5=#b48ead
palette = 6=#88c0d0
palette = 7=#e5e9f0
palette = 8=#4c566a
palette = 9=#bf616a
palette = 10=#a3be8c
palette = 11=#ebcb8b
palette = 12=#81a1c1
palette = 13=#b48ead
palette = 14=#8fbcbb
palette = 15=#eceff4

command = direct:/usr/bin/env PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin /opt/homebrew/bin/tmux -u
window-width = 124
window-height = 40
window-padding-x = 2
window-padding-y = 2
mouse-hide-while-typing = false

keybind = f11=toggle_fullscreen
keybind = shift+f11=toggle_maximize
keybind = shift+left=reset_font_size
keybind = shift+up=increase_font_size:1
keybind = shift+down=decrease_font_size:1
keybind = ctrl+left=reset_font_size
keybind = ctrl+up=increase_font_size:1
keybind = ctrl+down=decrease_font_size:1

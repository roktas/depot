#!/usr/bin/env bash

set -Eeuo pipefail
[[ -z ${TRACE:-} ]] || set -x
unset CDPATH

abort() {
	warn "E: $*"
	exit 1
}

warn() {
	printf '%s\n' "$*" >&2
}

usage() {
	cat <<'EOF'
Usage:
  vpn
  vpn on [EXIT_NODE]
  vpn off
  vpn status
  vpn list
EOF
}

tailscale_bin() {
	local os
	local path

	os=$(uname -s)
	if [[ $os == Linux && -x /usr/bin/tailscale ]]; then
		printf '%s\n' /usr/bin/tailscale
		return
	fi

	if [[ $os == Darwin ]]; then
		for path in \
			/Applications/Tailscale.app/Contents/MacOS/Tailscale \
			"$HOME"/Applications/Tailscale.app/Contents/MacOS/Tailscale; do
			if [[ -x $path ]]; then
				printf '%s\n' "$path"
				return
			fi
		done
	fi

	if command -v tailscale >/dev/null; then
		command -v tailscale
		return
	fi

	abort "tailscale CLI not found"
}

http_text() {
	local curl=$1
	local url=$2

	local value

	value=$("$curl" -fsSL --max-time 5 "$url" 2>/dev/null || true)
	value=${value//$'\r'/}
	value=${value//$'\n'/}
	printf '%s\n' "$value"
}

external_ip() {
	local curl
	local ip
	local url

	curl=$(command -v curl || true)
	[[ -n $curl ]] || {
		printf 'unavailable (curl missing)\n'
		return
	}

	for url in https://ipinfo.io/ip https://ifconfig.me/ip https://icanhazip.com; do
		ip=$("$curl" -fsSL --max-time 5 "$url" 2>/dev/null || true)
		ip=${ip//$'\r'/}
		ip=${ip//$'\n'/}
		if [[ $ip =~ ^[0-9A-Fa-f:.]+$ ]]; then
			printf '%s\n' "$ip"
			return
		fi
	done

	printf 'unavailable\n'
}

external_location() {
	local city
	local country
	local curl
	local location
	local region

	curl=$(command -v curl || true)
	[[ -n $curl ]] || {
		printf 'unavailable\n'
		return
	}

	city=$(http_text "$curl" https://ipinfo.io/city)
	region=$(http_text "$curl" https://ipinfo.io/region)
	country=$(http_text "$curl" https://ipinfo.io/country)

	location=$city
	[[ -z $region ]] || location=${location:+$location, }$region
	[[ -z $country ]] || location=${location:+$location, }$country

	printf '%s\n' "${location:-unavailable}"
}

exit_node() {
	local node=${1:-${TAILSCALE_EXIT_NODE:-}}

	[[ -n $node ]] || abort "missing exit node; set TAILSCALE_EXIT_NODE or pass EXIT_NODE"
	printf '%s\n' "$node"
}

tailscale_set() {
	local tailscale=$1
	shift

	if [[ $(uname -s) == Linux ]]; then
		sudo "$tailscale" set "$@"
	else
		"$tailscale" set "$@"
	fi
}

command_on() {
	local tailscale=$1
	local node

	node=$(exit_node "${2:-}")
	tailscale_set "$tailscale" --exit-node="$node" --exit-node-allow-lan-access
}

command_off() {
	local tailscale=$1

	tailscale_set "$tailscale" --exit-node=
}

command_status() {
	local tailscale=$1

	printf 'IP: %s  Location: %s\n\n' "$(external_ip)" "$(external_location)"
	"$tailscale" status
}

main() {
	local command=${1:-status}
	local tailscale

	case $command in
	-h | --help | help)
		usage
		return
		;;
	on | off | status | list) ;;
	*)
		usage >&2
		abort "unknown command: $command"
		;;
	esac

	tailscale=$(tailscale_bin)
	shift || true

	case $command in
	on)
		(($# <= 1)) || abort "too many arguments"
		command_on "$tailscale" "${1:-}"
		;;
	off)
		(($# == 0)) || abort "too many arguments"
		command_off "$tailscale"
		;;
	status)
		(($# == 0)) || abort "too many arguments"
		command_status "$tailscale"
		;;
	list)
		(($# == 0)) || abort "too many arguments"
		"$tailscale" exit-node list
		;;
	esac
}

main "$@"

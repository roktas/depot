#!/usr/bin/env bash

set -Eeuo pipefail; shopt -s nullglob; [[ -z ${TRACE:-} ]] || set -x; unset CDPATH; IFS=$' \n'

abort() {
	warn "E: $*"
	exit 1
}

usage() {
	cat <<-EOF
	Usage: lxd-smoke [options]

	Options:
	  --image IMAGE   LXD image alias (default: ubuntu:26.04)
	  --boot          Run the Linux bootstrap helper instead of the smoke script
	  --keep          Keep the instance for manual inspection
	  --name NAME     LXD instance name (default: home-lxd-smoke-<pid>)
	  --repo PATH     Repository root (default: current working directory)
	  -h, --help      Show this help
	EOF
}

warn() {
	echo -e "$*" >&2
}

apt_get() {
	lxc exec "$instance" -- env DEBIAN_FRONTEND=noninteractive apt-get \
		-o Acquire::Retries=3 \
		-o Acquire::ForceIPv4=true \
		"$@"
}

apt_update() {
	local attempt

	for attempt in {1..5}; do
		if apt_get -o APT::Update::Error-Mode=any update; then
			return
		fi
		warn "apt update failed in $instance; retrying ($attempt/5)..."
		sleep 5
	done

	abort "apt update failed after retries in instance: $instance"
}

check_outbound_http() {
	if lxc exec "$instance" -- bash -lc 'timeout 5 bash -lc "</dev/tcp/1.1.1.1/80"' >/dev/null 2>&1; then
		return
	fi

	lxc exec "$instance" -- bash -lc 'ip -4 addr show dev eth0; ip route; resolvectl dns eth0 || true' >&2 || true
	abort "outbound HTTP is not reachable from instance: $instance; check LXD bridge NAT/firewall forwarding"
}

wait_for_systemd() {
	for _ in {1..30}; do
		if lxc exec "$instance" -- test -S /run/systemd/private >/dev/null 2>&1; then
			return
		fi
		sleep 1
	done

	abort "systemd did not become ready in instance: $instance"
}

wait_for_network() {
	for _ in {1..30}; do
		if lxc exec "$instance" -- bash -lc 'systemctl is-active --quiet systemd-networkd && systemctl is-active --quiet systemd-resolved' >/dev/null 2>&1; then
			return
		fi
		sleep 1
	done

	lxc exec "$instance" -- bash -lc 'systemctl is-active systemd-networkd; systemctl is-active systemd-resolved' || true
	abort "network services did not become active in instance: $instance"
}

prepare_boot_user() {
	apt_update
	apt_get install -y --no-install-recommends sudo
	lxc exec "$instance" -- bash -lc '
		id -u ubuntu >/dev/null 2>&1 || useradd -m -s /bin/bash ubuntu
		mkdir -p /home/ubuntu
		chown ubuntu:ubuntu /home/ubuntu
		mkdir -p /etc/sudoers.d
		printf "%s\n" "ubuntu ALL=(ALL) NOPASSWD:ALL" >/etc/sudoers.d/90-ubuntu
		chmod 0440 /etc/sudoers.d/90-ubuntu
	'
}

cleanup() {
	local status=$?

	if [[ $keep != yes && -n ${instance:-} ]]; then
		lxc delete -f "$instance" >/dev/null 2>&1 || true
	fi

	exit "$status"
}

parse_args() {
	image=ubuntu:26.04
	instance=home-lxd-smoke-$$
	mode=smoke
	keep=no
	repo=$PWD

	while (($#)); do
		case $1 in
		--boot)
			mode=boot
		;;
		--image)
			shift
			(($#)) || abort "--image requires a value"
			image=$1
		;;
		--keep)
			keep=yes
		;;
		--name)
			shift
			(($#)) || abort "--name requires a value"
			instance=$1
		;;
		--repo)
			shift
			(($#)) || abort "--repo requires a value"
			repo=$1
		;;
		-h|--help)
			usage
			exit 0
		;;
		*)
			abort "unknown option: $1"
		;;
		esac
		shift
	done
}

main() {
	parse_args "$@"

	repo=$(cd -- "$repo" >/dev/null && pwd -P)
	[[ -f $repo/.agents/tests/provision/smoke.sh ]] || abort "missing provision smoke script: $repo"

	export LXC_CONFIG=${LXC_CONFIG:-/tmp/lxc-config}
	trap cleanup EXIT HUP INT QUIT TERM

	if lxc list "$instance" --format csv | grep -q .; then
		abort "instance already exists: $instance"
	fi

	lxc launch "$image" "$instance"
	lxc config set "$instance" security.nesting true
	lxc config device add "$instance" repo disk "source=$repo" path=/repo readonly=true
	lxc restart "$instance"
	wait_for_systemd
	wait_for_network
	check_outbound_http
	if [[ $mode == boot ]]; then
		prepare_boot_user
		lxc exec "$instance" -- su - ubuntu -c /repo/.agents/skills/provision/bin/bootstrap
		lxc exec "$instance" -- su - ubuntu -c 'ruby --version; git --version; curl --version | head -n 1'
	else
		apt_update
		apt_get install -y --no-install-recommends ca-certificates git ruby
		lxc exec "$instance" -- /repo/.agents/tests/provision/smoke.sh
	fi

	if [[ $keep == yes ]]; then
		warn "Kept LXD instance: $instance"
	fi
}

main "$@"

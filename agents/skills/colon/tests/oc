#!/usr/bin/env bash

set -Eeuo pipefail
[[ -z ${TRACE:-} ]] || set -x
unset CDPATH

TEST_DIR=$(cd "${BASH_SOURCE[0]%/*}" && pwd -P) || exit
readonly TEST_DIR
readonly OC_BIN=$TEST_DIR/../bin/oc
TEST_ROOT=$(mktemp -d) || exit
readonly TEST_ROOT

abort() {
	printf 'E: %s\n' "$*" >&2
	exit 1
}

# ------------------------------------------------------------------------------------------------------------------------
# Helpers
# ------------------------------------------------------------------------------------------------------------------------

assert_absent() {
	local pattern=$1

	if compgen -G "$pattern" >/dev/null; then
		abort "unexpected path matching: $pattern"
	fi
}

assert_contains() {
	local haystack=$1
	local needle=$2

	[[ $haystack == *"$needle"* ]] || abort "missing text: $needle"
}

assert_equal() {
	local actual=$1
	local expected=$2

	[[ $actual == "$expected" ]] || abort "expected '$expected', got '$actual'"
}

install_cleanup_stub() {
	local stub=$1

	cat >"$stub" <<-'STUB'
		#!/usr/bin/env bash

		/bin/rm "$@"
		exit 97
	STUB
	chmod +x "$stub"
}

install_stub() {
	local stub=$1

	cat >"$stub" <<-'STUB'
		#!/usr/bin/env bash

		set -Eeuo pipefail

		printf '%s\n' "$*" >>"$OPENCODE_LOG"

		case ${1:-} in
		db)
			if [[ ${OPENCODE_DB_OUTPUT+x} ]]; then
				printf '%s\n' "$OPENCODE_DB_OUTPUT"
			else
				printf '%s\n' '[{"id":"latest"}]'
			fi
			;;
		export)
			case ${OPENCODE_EXPORT_MODE:-valid} in
			fail)
				exit 7
				;;
			malformed)
				printf '%s\n' 'Exporting session without a document'
				;;
			valid)
				printf 'Exporting session: %s\n' "$2"
				printf '{"info":{"id":"%s"},"messages":[]}\n' "$2"
				;;
			esac
			;;
		esac
	STUB
	chmod +x "$stub"
}

# ------------------------------------------------------------------------------------------------------------------------
# Main
# ------------------------------------------------------------------------------------------------------------------------

main() {
	local cleanup_dir
	local log
	local output
	local status
	local stub_dir
	local temp_dir

	trap 'status=$?; rm -rf -- "$TEST_ROOT" || :; exit "$status"' EXIT
	trap 'exit 129' HUP
	trap 'exit 130' INT
	trap 'exit 131' QUIT
	trap 'exit 143' TERM

	cleanup_dir=$TEST_ROOT/cleanup-bin
	log=$TEST_ROOT/opencode.log
	stub_dir=$TEST_ROOT/bin
	temp_dir=$TEST_ROOT/tmp
	mkdir -p "$cleanup_dir" "$stub_dir" "$temp_dir"
	install_cleanup_stub "$cleanup_dir/rm"
	install_stub "$stub_dir/opencode"

	output=$(PATH=/usr/bin:/bin "$OC_BIN" --help)
	[[ $output == *'oc SESSION_ID'* ]] || abort 'help output is incomplete'

	output=$(OPENCODE_LOG=$log PATH=$stub_dir:$PATH TMPDIR=$temp_dir "$OC_BIN" --id)
	assert_equal "$output" latest
	assert_contains "$(<"$log")" 'parent_id IS NULL AND time_archived IS NULL ORDER BY time_updated DESC'

	: >"$log"
	output=$(OPENCODE_LOG=$log PATH=$stub_dir:$PATH TMPDIR=$temp_dir "$OC_BIN")
	assert_equal "$output" '{"info":{"id":"latest"},"messages":[]}'
	assert_contains "$(<"$log")" 'export latest'
	assert_absent "$temp_dir/*"

	: >"$log"
	output=$(OPENCODE_LOG=$log PATH=$stub_dir:$PATH TMPDIR=$temp_dir "$OC_BIN" explicit)
	assert_equal "$output" '{"info":{"id":"explicit"},"messages":[]}'
	assert_contains "$(<"$log")" 'export explicit'
	assert_absent "$temp_dir/*"

	if OPENCODE_EXPORT_MODE=malformed OPENCODE_LOG=$log PATH=$stub_dir:$PATH TMPDIR=$temp_dir "$OC_BIN" explicit \
		>/dev/null 2>&1; then
		abort 'malformed export unexpectedly succeeded'
	fi
	assert_absent "$temp_dir/*"

	if OPENCODE_EXPORT_MODE=fail OPENCODE_LOG=$log PATH=$stub_dir:$PATH TMPDIR=$temp_dir "$OC_BIN" explicit \
		>/dev/null 2>&1; then
		abort 'failed export unexpectedly succeeded'
	fi
	assert_absent "$temp_dir/*"
	if OPENCODE_EXPORT_MODE=fail OPENCODE_LOG=$log PATH=$cleanup_dir:$stub_dir:$PATH TMPDIR=$temp_dir \
		"$OC_BIN" explicit >/dev/null 2>&1; then
		abort 'failed export with failed cleanup unexpectedly succeeded'
	else
		status=$?
	fi
	assert_equal "$status" 1
	assert_absent "$temp_dir/*"

	if OPENCODE_DB_OUTPUT='[]' OPENCODE_LOG=$log PATH=$stub_dir:$PATH TMPDIR=$temp_dir "$OC_BIN" --id \
		>/dev/null 2>&1; then
		abort 'empty session database unexpectedly succeeded'
	fi
}

main "$@"

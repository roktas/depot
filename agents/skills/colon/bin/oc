#!/usr/bin/env bash

set -Eeuo pipefail
[[ -z ${TRACE:-} ]] || set -x
unset CDPATH

abort() {
	warn "E: $*"
	exit 1
}

warn() {
	printf '%s\n' "$*" >&2
}

# ------------------------------------------------------------------------------------------------------------------------
# Helpers
# ------------------------------------------------------------------------------------------------------------------------

export_session() (
	local session_id=$1

	local tempfile

	tempfile=$(mktemp) || exit
	trap 'status=$?; rm -f -- "$tempfile" || :; exit "$status"' EXIT
	trap 'exit 129' HUP
	trap 'exit 130' INT
	trap 'exit 131' QUIT
	trap 'exit 143' TERM

	if ! opencode export "$session_id" >"$tempfile"; then
		return 1
	fi

	ruby -e '
		input = File.read(ARGV.fetch(0))
		start = input.index("{")
		abort("opencode export did not emit JSON") unless start
		print input[start..]
	' "$tempfile"
)

latest_id() {
	opencode db \
		"SELECT id FROM session WHERE parent_id IS NULL AND time_archived IS NULL ORDER BY time_updated DESC LIMIT 1" \
		--format json | ruby -rjson -e '
		sessions = JSON.parse(STDIN.read)
		abort("no opencode sessions") if sessions.empty?
		puts sessions.fetch(0).fetch("id")
	'
}

# ------------------------------------------------------------------------------------------------------------------------
# Main
# ------------------------------------------------------------------------------------------------------------------------

usage() {
	cat <<-EOF
		Usage:
		  oc
		  oc SESSION_ID
		  oc --id
	EOF
}

main() {
	case ${1:-} in
	-h | --help | help)
		usage
		return
		;;
	esac

	command -v opencode >/dev/null || abort "opencode is not on PATH"
	command -v ruby >/dev/null || abort "ruby is not on PATH"

	case ${1:-} in
	--id | id)
		latest_id
		;;
	"")
		export_session "$(latest_id)"
		;;
	*)
		(($# == 1)) || abort "usage: oc [SESSION_ID]"
		export_session "$1"
		;;
	esac
}

main "$@"

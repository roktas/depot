#!/usr/bin/env bash

set -Eeuo pipefail
[[ -z ${TRACE:-} ]] || set -x
unset CDPATH

abort() {
	warn "E: $*"
	exit 1
}

warn() {
	printf '%s\n' "$*" >&2
}

# ------------------------------------------------------------------------------------------------------------------------
# Helpers
# ------------------------------------------------------------------------------------------------------------------------

append_item() {
	local todo_file=$1
	local item=$2

	local inserted=
	local in_inbox=
	local line
	local tempfile

	[[ $item != *$'\n'* && $item != *$'\r'* ]] || abort "todo item must be one line"

	tempfile=$(mktemp "${todo_file%/*}/todo.XXXXXXXX") || exit
	cp -p "$todo_file" "$tempfile" || {
		rm -f "$tempfile"
		return 1
	}
	: >"$tempfile"

	while IFS= read -r line || [[ -n $line ]]; do
		if [[ -n $in_inbox && -z $inserted && $line == "## "* ]]; then
			printf '%s\n\n' "- [ ] $item" >>"$tempfile"
			inserted=true
			in_inbox=
		fi

		printf '%s\n' "$line" >>"$tempfile"

		if [[ $line == "## Inbox" ]]; then
			in_inbox=true
		fi
	done <"$todo_file"

	if [[ -z $inserted ]]; then
		if [[ -z $in_inbox ]]; then
			printf '\n## Inbox\n\n' >>"$tempfile"
		fi
		printf '%s\n' "- [ ] $item" >>"$tempfile"
	fi

	mv "$tempfile" "$todo_file"
}

editor() {
	local todo_file=$1

	local editor=${VISUAL:-${EDITOR:-vi}}
	local -a editor_command

	read -r -a editor_command <<<"$editor"
	((${#editor_command[@]} > 0)) || abort "editor command is empty"
	"${editor_command[@]}" "$todo_file"
}

emit_todo() {
	local todo_file=$1

	local index=0
	local line

	while IFS= read -r line; do
		case $line in
		"- [ ] "* | "- [x] "*)
			((index += 1))
			printf '%2d  %s\n' "$index" "$line"
			;;
		*)
			printf '%s\n' "$line"
			;;
		esac
	done <"$todo_file"
}

ensure_file() {
	local todo_file=$1

	mkdir -p "${todo_file%/*}"
	if [[ -e $todo_file ]]; then
		return
	fi

	cat >"$todo_file" <<-EOF
		# TODO

		## Now

		## Next

		## Inbox

	EOF
}

remove_item() {
	local todo_file=$1
	local item=$2

	local current=0
	local found=
	local line
	local tempfile

	[[ $item =~ ^[0-9]+$ ]] || abort "todo item must be a number: $item"

	tempfile=$(mktemp "${todo_file%/*}/todo.XXXXXXXX") || exit
	cp -p "$todo_file" "$tempfile" || {
		rm -f "$tempfile"
		return 1
	}
	: >"$tempfile"

	while IFS= read -r line || [[ -n $line ]]; do
		case $line in
		"- [ ] "* | "- [x] "*)
			((current += 1))
			if ((current == item)); then
				found=true
				continue
			fi
			;;
		esac

		printf '%s\n' "$line" >>"$tempfile"
	done <"$todo_file"

	if [[ -z $found ]]; then
		rm -f "$tempfile"
		abort "todo item not found: $item"
	fi

	mv "$tempfile" "$todo_file"
}

prompt_ok_item() {
	local todo_file=$1

	local item

	emit_todo "$todo_file"
	printf 'OK item: ' >&2
	read -r item
	[[ -n $item ]] || abort "todo item is empty"
	printf '%s\n' "$item"
}

repo_root() {
	git rev-parse --show-toplevel 2>/dev/null || abort "not inside a Git repository"
}

require_file() {
	local todo_file=$1

	[[ -f $todo_file ]] || abort "TODO file not found: $todo_file"
}

todo_path() {
	local owner=$1
	local root=$2

	case $owner in
	shared | human | agent)
		printf '%s\n' "$root/TODO.md"
		;;
	*)
		abort "owner must be shared, human, or agent"
		;;
	esac
}

# ------------------------------------------------------------------------------------------------------------------------
# Main
# ------------------------------------------------------------------------------------------------------------------------

usage() {
	cat <<-EOF
		Usage:
		  todo shared TEXT
		  todo shared
		  todo shared --ok [NUMBER]
		  todo shared --edit
		  todo shared --path

		Compatibility aliases:
		  todo human ...
		  todo agent ...
	EOF
}

main() {
	if (($# < 1)); then
		usage
		exit 2
	fi

	local owner=$1
	shift

	local item
	local root
	local todo_file

	case ${1:-} in
	--help | -h | help)
		usage
		return
		;;
	esac

	root=$(repo_root)
	todo_file=$(todo_path "$owner" "$root")

	if (($# == 0)); then
		require_file "$todo_file"
		emit_todo "$todo_file"
		return
	fi

	case $1 in
	--ok | ok | --done | done)
		shift
		require_file "$todo_file"

		item=${1:-}

		if [[ -z $item ]]; then
			item=$(prompt_ok_item "$todo_file")
		fi

		remove_item "$todo_file" "$item"
		printf '%s\n' "$todo_file"
		;;
	--edit | edit)
		ensure_file "$todo_file"
		editor "$todo_file"
		;;
	--path | path)
		printf '%s\n' "$todo_file"
		;;
	*)
		ensure_file "$todo_file"
		append_item "$todo_file" "$*"
		printf '%s\n' "$todo_file"
		;;
	esac
}

main "$@"

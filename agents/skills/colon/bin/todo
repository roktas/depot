#!/usr/bin/env bash

set -Eeuo pipefail
[[ -z ${TRACE:-} ]] || set -x
unset CDPATH

abort() {
	warn "E: $*"
	exit 1
}

warn() {
	echo -e "$*" >&2
}

# ------------------------------------------------------------------------------------------------------------------------
# Helpers
# ------------------------------------------------------------------------------------------------------------------------

editor() {
	local todo_file=$1

	${VISUAL:-${EDITOR:-vi}} "$todo_file"
}

emit_todo() {
	local todo_file=$1

	local index=0
	local line

	while IFS= read -r line; do
		case $line in
		"- [ ] "*|"- [x] "*)
			((index += 1))
			printf '%2d  %s\n' "$index" "$line"
		;;
		*)
			printf '%s\n' "$line"
		;;
		esac
	done <"$todo_file"
}

ensure_file() {
	local todo_file=$1

	mkdir -p "${todo_file%/*}"
	if [[ -e $todo_file ]]; then
		return
	fi

	cat >"$todo_file" <<-EOF
	# TODO

	## Inbox

	EOF
}

mark_ok() {
	local todo_file=$1
	local item=$2

	local current=0
	local found=
	local line
	local tempfile

	[[ $item =~ ^[0-9]+$ ]] || abort "todo item must be a number: $item"

	tempfile=$(mktemp "${todo_file%/*}/todo.XXXXXXXX") || exit

	while IFS= read -r line; do
		case $line in
		"- [ ] "*|"- [x] "*)
			((current += 1))
			if ((current == item)); then
				found=true
				if [[ $line == "- [ ] "* ]]; then
					line="- [x] ${line#"- [ ] "}"
				fi
			fi
		;;
		esac

		printf '%s\n' "$line" >>"$tempfile"
	done <"$todo_file"

	if [[ -z $found ]]; then
		rm -f "$tempfile"
		abort "todo item not found: $item"
	fi

	mv "$tempfile" "$todo_file"
}

prompt_ok_item() {
	local todo_file=$1

	local item

	emit_todo "$todo_file"
	printf 'OK item: ' >&2
	read -r item
	[[ -n $item ]] || abort "todo item is empty"
	printf '%s\n' "$item"
}

repo_root() {
	git rev-parse --show-toplevel 2>/dev/null || abort "not inside a Git repository"
}

todo_path() {
	local owner=$1
	local root=$2

	case $owner in
	shared|human|agent)
		printf '%s\n' "$root/.agents/notes/todo.md"
	;;
	*)
		abort "owner must be shared, human, or agent"
	;;
	esac
}

# ------------------------------------------------------------------------------------------------------------------------
# Main
# ------------------------------------------------------------------------------------------------------------------------

usage() {
	cat <<-EOF
	Usage:
	  todo shared TEXT
	  todo shared
	  todo shared --ok [NUMBER]
	  todo shared --edit
	  todo shared --path

	Compatibility aliases:
	  todo human ...
	  todo agent ...
	EOF
}

main() {
	if (($# < 1)); then
		usage
		exit 2
	fi

	local owner=$1
	shift

	local item
	local root
	local todo_file

	root=$(repo_root)
	todo_file=$(todo_path "$owner" "$root")
	ensure_file "$todo_file"

	if (($# == 0)); then
		emit_todo "$todo_file"
		return
	fi

	case $1 in
	--ok|ok|--done|done)
		shift

		item=${1:-}

		if [[ -z $item ]]; then
			item=$(prompt_ok_item "$todo_file")
		fi

		mark_ok "$todo_file" "$item"
		printf '%s\n' "$todo_file"
	;;
	--edit|edit)
		editor "$todo_file"
	;;
	--path|path)
		printf '%s\n' "$todo_file"
	;;
	--help|-h|help)
		usage
	;;
	*)
		printf -- '- [ ] %s\n' "$*" >>"$todo_file"
		printf '%s\n' "$todo_file"
	;;
	esac
}

main "$@"

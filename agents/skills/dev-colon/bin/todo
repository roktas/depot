#!/usr/bin/env bash

set -Eeuo pipefail; shopt -s nullglob; [[ -z ${TRACE:-} ]] || set -x; unset CDPATH; IFS=$' \n'

abort() {
	warn "E: $*"
	exit 1
}

warn() {
	echo -e "$*" >&2
}

# ------------------------------------------------------------------------------------------------------------------------
# Helpers
# ------------------------------------------------------------------------------------------------------------------------

editor() {
	local todo_file=$1

	${VISUAL:-${EDITOR:-vi}} "$todo_file"
}

ensure_file() {
	local owner=$1
	local todo_file=$2

	mkdir -p "${todo_file%/*}"
	if [[ -e $todo_file ]]; then
		return
	fi

	cat >"$todo_file" <<-EOF
	# ${owner^} TODO

	## Inbox

	EOF
}

repo_root() {
	git rev-parse --show-toplevel 2>/dev/null || abort "not inside a Git repository"
}

# ------------------------------------------------------------------------------------------------------------------------
# Main
# ------------------------------------------------------------------------------------------------------------------------

usage() {
	cat <<-EOF
	Usage:
	  todo human TEXT
	  todo agent TEXT
	  todo human --edit
	  todo agent --path
	EOF
}

main() {
	if (($# < 1)); then
		usage
		exit 2
	fi

	local owner=$1
	shift

	local root
	local todo_file

	case $owner in
	human|agent)
	;;
	*)
		abort "owner must be human or agent"
	;;
	esac

	root=$(repo_root)
	todo_file=$root/.agents/state/$owner/todo.md
	ensure_file "$owner" "$todo_file"

	if (($# == 0)); then
		editor "$todo_file"
		return
	fi

	case $1 in
	--edit|edit)
		editor "$todo_file"
	;;
	--path|path)
		printf '%s\n' "$todo_file"
	;;
	--help|-h|help)
		usage
	;;
	*)
		printf -- '- [ ] %s\n' "$*" >>"$todo_file"
		printf '%s\n' "$todo_file"
	;;
	esac
}

main "$@"

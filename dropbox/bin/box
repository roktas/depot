#!/usr/bin/env bash

set -Eeuo pipefail
[[ -z ${TRACE:-} ]] || set -x
unset CDPATH

readonly SERVICE=dropbox.service
readonly SERVICE_MARKER="# Managed by Tilde home/dropbox."

abort() {
	warn "E: $*"
	exit 1
}

warn() {
	printf '%s\n' "$*" >&2
}

# ------------------------------------------------------------------------------------------------------------------------
# Helpers
# ------------------------------------------------------------------------------------------------------------------------

disable_desktop_autostart() {
	local file=$HOME/.config/autostart/dropbox.desktop

	if command -v timeout >/dev/null; then
		timeout 10s dropbox autostart n >/dev/null 2>&1 || true
	else
		dropbox autostart n >/dev/null 2>&1 || true
	fi

	[[ -f $file ]] || return 0

	set_desktop_key "$file" Hidden true
	set_desktop_key "$file" X-GNOME-Autostart-enabled false
}

dropbox_command() {
	command -v dropbox || abort "dropbox command is missing"
}

dropbox_ready() {
	[[ $(uname -s) == Linux ]] || return 1
	command -v dropbox >/dev/null 2>&1 || return 1
	command -v loginctl >/dev/null 2>&1 || return 1
	command -v systemctl >/dev/null 2>&1 || return 1
	[[ -d $HOME/.dropbox ]] || return 1
	[[ -x $HOME/.dropbox-dist/dropboxd ]]
}

enable_linger() {
	local user

	user=$(id -un)
	if [[ $(loginctl show-user "$user" -p Linger --value 2>/dev/null || true) != yes ]]; then
		sudo loginctl enable-linger "$user"
	fi
}

install_service() {
	local dir=$HOME/.config/systemd/user
	local service=$dir/$SERVICE

	local link
	local tmp

	mkdir -p "$dir"
	tmp=$(mktemp) || exit
	cat >"$tmp" <<EOF_SERVICE
$SERVICE_MARKER
[Unit]
Description=Dropbox Sync Service
ConditionPathExists=%h/.dropbox
ConditionFileIsExecutable=%h/.dropbox-dist/dropboxd

[Service]
Type=simple
ExecStart=%h/.dropbox-dist/dropboxd
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=default.target
EOF_SERVICE

	if [[ -L $service ]]; then
		link=$(readlink "$service")
		case $link in
		*/Dropbox/home/dropbox/dropbox.service | */Dropbox/home-/dropbox/dropbox.service | */.local/src/home/dropbox/dropbox.service | */.local/src/home-/dropbox/dropbox.service)
			rm -f "$service"
			;;
		*)
			warn "E: refusing to replace unmanaged symlink: $service -> $link"
			rm -f "$tmp"
			exit 1
			;;
		esac
	fi

	if [[ -e $service && ! -f $service ]]; then
		warn "E: refusing to replace non-file service target: $service"
		rm -f "$tmp"
		exit 1
	fi

	if [[ -f $service && ! -s $service ]]; then
		rm -f "$service"
	fi

	if [[ -f $service && ! -r $service ]]; then
		warn "E: service target is not readable: $service"
		rm -f "$tmp"
		exit 1
	fi

	if [[ ! -f $service ]] || ! cmp -s "$tmp" "$service"; then
		if [[ -f $service && -s $service ]] && ! grep -qxF "$SERVICE_MARKER" "$service"; then
			warn "E: refusing to overwrite unmanaged service file: $service"
			rm -f "$tmp"
			exit 1
		fi
		cp "$tmp" "$service"
	fi
	rm -f "$tmp"
}

linger_state() {
	loginctl show-user "$(id -un)" -p Linger --value 2>/dev/null || printf 'unknown\n'
}

load_user_bus() {
	local uid

	uid=$(id -u)
	if [[ -z ${XDG_RUNTIME_DIR:-} && -d /run/user/$uid ]]; then
		export XDG_RUNTIME_DIR=/run/user/$uid
	fi

	if [[ -z ${DBUS_SESSION_BUS_ADDRESS:-} && -n ${XDG_RUNTIME_DIR:-} && -S $XDG_RUNTIME_DIR/bus ]]; then
		export DBUS_SESSION_BUS_ADDRESS=unix:path=$XDG_RUNTIME_DIR/bus
	fi
}

service_exists() {
	command -v systemctl >/dev/null 2>&1 || return 1

	load_user_bus
	systemctl --user cat "$SERVICE" >/dev/null 2>&1
}

set_desktop_key() {
	local file=$1
	local key=$2
	local value=$3

	local tmp

	tmp=$(mktemp) || exit
	awk '
		BEGIN {
			found = 0
			prefix = key "="
		}
		index($0, prefix) == 1 {
			if (!found) {
				print key "=" value
				found = 1
			}
			next
		}
		{ print }
		END {
			if (!found) {
				print key "=" value
			}
		}
	' key="$key" value="$value" "$file" >"$tmp" || {
		rm -f "$tmp"
		return 1
	}
	if ! cmp -s "$tmp" "$file"; then
		cp "$tmp" "$file" || {
			rm -f "$tmp"
			return 1
		}
	fi
	rm -f "$tmp"
}

stop_legacy_dropbox() {
	if ! systemctl_user is-active "$SERVICE" >/dev/null 2>&1 &&
		pgrep -u "$(id -u)" -x dropbox >/dev/null 2>&1; then
		dropbox stop >/dev/null 2>&1 || true
	fi
}

systemctl_user() {
	load_user_bus
	systemctl --user "$@"
}

# ------------------------------------------------------------------------------------------------------------------------
# Commands
# ------------------------------------------------------------------------------------------------------------------------

command.disable() {
	service_exists || abort "$SERVICE is not installed"
	systemctl_user disable --now "$SERVICE"
}

command.enable() {
	if ! service_exists && dropbox_ready; then
		install_service
		systemctl_user daemon-reload
	fi
	service_exists || abort "$SERVICE is not installed"
	if [[ $(uname -s) == Linux && $(linger_state) != yes ]]; then
		warn "W: linger is disabled; run: sudo loginctl enable-linger $(id -un)"
	fi
	systemctl_user enable --now "$SERVICE"
}

command.logs() {
	service_exists || abort "$SERVICE is not installed"
	journalctl --user -u "$SERVICE" "$@"
}

command.provision() {
	dropbox_ready || return 0

	disable_desktop_autostart
	enable_linger
	install_service
	systemctl_user daemon-reload
	systemctl_user enable "$SERVICE"
	stop_legacy_dropbox
	systemctl_user start "$SERVICE"
}

command.restart() {
	if service_exists; then
		systemctl_user restart "$SERVICE"
	else
		"$(dropbox_command)" stop >/dev/null 2>&1 || true
		"$(dropbox_command)" start
	fi
}

command.start() {
	if service_exists; then
		systemctl_user start "$SERVICE"
	else
		"$(dropbox_command)" start "$@"
	fi
}

command.status() {
	local active
	local dropbox
	local enabled

	dropbox=$(dropbox_command)
	if [[ $(uname -s) != Linux ]]; then
		printf 'service: unsupported\n'
	elif service_exists; then
		enabled=$(systemctl_user is-enabled "$SERVICE" 2>/dev/null || true)
		active=$(systemctl_user is-active "$SERVICE" 2>/dev/null || true)
		printf 'service: %s / %s\n' "${enabled:-unknown}" "${active:-unknown}"
		printf 'linger: %s\n' "$(linger_state)"
	else
		printf 'service: missing\n'
	fi

	printf 'dropbox: '
	"$dropbox" status
}

command.stop() {
	if service_exists; then
		systemctl_user stop "$SERVICE"
	else
		"$(dropbox_command)" stop "$@"
	fi
}

# ------------------------------------------------------------------------------------------------------------------------
# Main
# ------------------------------------------------------------------------------------------------------------------------

usage() {
	cat <<'EOF'
Usage: box COMMAND [ARG...]

Commands:
  status       Show service and Dropbox sync status
  start        Start Dropbox through the user service when available
  stop         Stop Dropbox through the user service when available
  restart      Restart Dropbox through the user service when available
  provision    Ensure the Linux user service when Dropbox is initialized
  enable       Enable and start the user service
  disable      Disable and stop the user service
  logs         Show user-service logs
  cli ARG...   Run the Dropbox CLI directly
EOF
}

main() {
	local command=${1:-status}

	[[ $# -eq 0 ]] || shift
	case $command in
	status | start | stop | restart | provision | enable | disable | logs)
		"command.$command" "$@"
		;;
	cli)
		"$(dropbox_command)" "$@"
		;;
	-h | --help | help)
		usage
		;;
	*)
		"$(dropbox_command)" "$command" "$@"
		;;
	esac
}

main "$@"

#!/usr/bin/env bash

set -Eeuo pipefail; shopt -s nullglob; [[ -z ${TRACE:-} ]] || set -x; unset CDPATH; IFS=$' \n'

abort() {
	warn "E: $*"
	exit 1
}

warn() {
	echo -e "$*" >&2
}

# ------------------------------------------------------------------------------------------------------------------------
# Helpers
# ------------------------------------------------------------------------------------------------------------------------

climb() {
	local cwd=$1
	shift

	cd "$cwd" || exit

	while :; do
		local try

		for try; do
			if [[ -e $try ]]; then
				return 0
			fi
		done

		# shellcheck disable=2128
		if [[ $PWD == "/" ]]; then
			break
		fi

		cd .. || exit
	done

	return 1
}

# ------------------------------------------------------------------------------------------------------------------------
# Main
# ------------------------------------------------------------------------------------------------------------------------

main() {
	climb . Rakefile Makefile make || abort "No [MR]akefile found"

	local -a args

	if [[ -f Rakefile ]]; then
		if [[ -f Gemfile ]] || [[ -f ../Gemfile ]]; then
			args=(bundle exec rake)
		else
			args=(rake)
		fi
	elif [[ -f make ]]; then
		[[ -x make ]] || abort "Unexecutable make"
		args=(./make)
	else
		args=(make)
	fi

	exec "${args[@]}" "$@"
}

main "$@"

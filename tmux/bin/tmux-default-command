#!/usr/bin/env bash

set -Eeuo pipefail; shopt -s nullglob; [[ -z ${TRACE:-} ]] || set -x; unset CDPATH; IFS=$' \n'

export PATH="$HOME/.local/bin:/opt/homebrew/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin${PATH:+:$PATH}"

main() {
	local current_window
	local preferred_shell

	preferred_shell=$(command -v fish || printf '%s\n' "${SHELL:-/bin/sh}")
	current_window=$(tmux display-message -p '#I')

	if [[ $current_window == 0 ]]; then
		tmux rename-window "Hello"
		exec "$preferred_shell" -l
	fi

	exec "$preferred_shell"
}

main "$@"
